# Copy this file to .env and adjust if needed.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>

# Use this when running the app directly on your machine, against the
# Dockerized Postgres from step 1 (published on localhost:5432):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_db

# When the app itself runs inside docker-compose (step 5), use the
# service name "db" as the host instead of "localhost":
# DATABASE_URL=postgresql://postgres:postgres@db:5432/task_db
